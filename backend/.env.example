NODE_ENV=development
PORT=5000
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# SQLite database file and upload directory (defaults: ./data/sportify.db and ./uploads)
DB_PATH=./data/sportify.db
UPLOAD_DIR=./uploads
# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGIN=http://localhost:5173
MAX_AUDIO_SIZE_MB=20
MAX_IMAGE_SIZE_MB=5
# Built frontend to serve from this server (run `npm run build` in ../frontend first)
FRONTEND_DIST=../frontend/dist
